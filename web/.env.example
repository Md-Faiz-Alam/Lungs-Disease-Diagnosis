# Copy to .env.local for local development. All values are public (bundled into the SPA): never put secrets here.
VITE_API_BASE_URL=            # empty in dev (Vite proxies /api to :8000); https://<api>.azurecontainerapps.io in prod
VITE_AUTH_MODE=demo           # demo | entra
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=         # SPA app registration (client) ID
VITE_API_SCOPE=               # api://<api-app-id>/Studies.ReadWrite
